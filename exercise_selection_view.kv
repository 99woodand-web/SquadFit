# exercise_selection_view.kv - Exercise browsing with search, filters, and cards
#:import animations animations
<ExerciseSelectionScreen>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: app.canvas_bg
        Rectangle:
            pos: self.pos
            size: self.size
        # Subtle texture overlay
        Color:
            rgba: 1, 1, 1, 0.15
        Rectangle:
            source: 'assets/app_bg.jpeg'
            pos: self.pos
            size: self.size

    # ═══ HEADER ═══
    BoxLayout:
        size_hint_y: None
        height: dp(45)
        spacing: dp(10)

        MDIconButton:
            icon: "chevron-left"
            icon_size: '24sp'
            theme_text_color: "Custom"
            text_color: app.accent_color
            size_hint_x: None
            width: dp(48)
            on_release: animations.button_flash(self); root.go_back()

        Label:
            text: "PROGRAM LAB"
            font_size: '16sp'
            bold: True
            color: app.accent_color

        Widget:
            size_hint_x: 0.3

    # ═══ SEARCH BAR ═══
    BoxLayout:
        size_hint_y: None
        height: dp(42)
        spacing: dp(8)

        TextInput:
            id: search_input
            hint_text: "Search exercises..."
            hint_text_color: (0.4, 0.4, 0.4, 1)
            font_size: '14sp'
            multiline: False
            write_tab: False
            background_color: app.card_bg
            foreground_color: (1, 1, 1, 1)
            cursor_color: app.card_bg
            padding: [dp(12), dp(10), dp(12), dp(10)]
            size_hint_x: 0.7
            on_text: root.filter_exercises()



    # ═══ MUSCLE GROUP TABS (2 rows, no scroll) ═══
    BoxLayout:
        id: muscle_tabs
        orientation: 'vertical'
        size_hint_y: None
        height: dp(76)
        spacing: dp(6)

    # ═══ SELECTED COUNT ═══
    Label:
        id: lbl_selected_count
        text: "Selected: 0 / 0"
        font_size: '11sp'
        color: 0.5, 0.5, 0.5, 1
        size_hint_y: None
        height: dp(20)

    # ═══ EXERCISE LIST ═══
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            id: exercise_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)

    # ═══ BOTTOM BUTTONS ═══
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(10)

        Button:
            text: "CLEAR"
            font_size: '12sp'
            bold: True
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: 0.6, 0.6, 0.6, 1
            canvas.before:
                Color:
                    rgba: app.card_bg
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]
            on_press: animations.button_flash(self); root.deselect_all()

        Button:
            text: "SAVE PROGRAM"
            bold: True
            font_size: '12sp'
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: 0.0, 0.8, 1.0, 1
            border: (0, 0, 0, 0)
            canvas.before:
                Color:
                    rgba: 0.0, 0.8, 1.0, 0.15
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(25)]
            on_press: animations.button_flash(self); root.save_as_template()
