# exercise_selection_view.kv - Exercise browsing with search, filters, and cards
#:import animations animations
<ExerciseSelectionScreen>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: app.canvas_bg
        Rectangle:
            pos: self.pos
            size: self.size
        # Subtle texture overlay
        Color:
            rgba: 1, 1, 1, 0.15
        Rectangle:
            source: 'assets/app_bg.jpeg'
            pos: self.pos
            size: self.size

    # ═══ HEADER ═══
    BoxLayout:
        size_hint_y: None
        height: dp(45)
        spacing: dp(10)

        MDIconButton:
            icon: "chevron-left"
            icon_size: '24sp'
            theme_text_color: "Custom"
            text_color: app.accent_color
            size_hint_x: None
            width: dp(48)
            on_release: animations.button_flash(self); root.go_back()

        Label:
            text: "MY EXERCISES"
            font_size: '16sp'
            bold: True
            color: app.accent_color

        Widget:
            size_hint_x: 0.3

    # ═══ SEARCH BAR ═══
    BoxLayout:
        size_hint_y: None
        height: dp(42)
        spacing: dp(8)

        TextInput:
            id: search_input
            hint_text: "Search exercises..."
            hint_text_color: (0.4, 0.4, 0.4, 1)
            font_size: '14sp'
            multiline: False
            write_tab: False
            background_color: app.card_bg
            foreground_color: (1, 1, 1, 1)
            cursor_color: app.accent_color
            padding: [dp(12), dp(10), dp(12), dp(10)]
            size_hint_x: 0.7
            on_text: root.filter_exercises()

        Button:
            text: "CLEAR"
            font_size: '11sp'
            bold: True
            size_hint_x: 0.3
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: 0.07, 0.07, 0.07, 1
            canvas.before:
                Color:
                    rgba: app.accent_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]
            on_press: animations.button_flash(self); root.clear_search()

    # ═══ MUSCLE GROUP TABS ═══
    ScrollView:
        size_hint_y: None
        height: dp(36)
        do_scroll_x: True
        do_scroll_y: False
        bar_width: 0

        BoxLayout:
            id: muscle_tabs
            orientation: 'horizontal'
            size_hint_x: None
            width: self.minimum_width
            spacing: dp(6)

    # ═══ EQUIPMENT FILTER ROW (built programmatically for active state) ═══
    BoxLayout:
        id: equip_tabs
        size_hint_y: None
        height: dp(32)
        spacing: dp(6)

    # ═══ SELECTED COUNT ═══
    Label:
        id: lbl_selected_count
        text: "Selected: 0 / 0 exercises"
        font_size: '11sp'
        color: 0.5, 0.5, 0.5, 1
        size_hint_y: None
        height: dp(18)

    # ═══ EXERCISE LIST ═══
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            id: exercise_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)

    # ═══ BOTTOM BUTTONS ═══
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(10)

        Button:
            text: "SELECT ALL"
            font_size: '12sp'
            bold: True
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: app.accent_color
            canvas.before:
                Color:
                    rgba: app.card_bg
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]
            on_press: animations.button_flash(self); root.select_all()

        Button:
            text: "MY EXERCISES"
            font_size: '14sp'
            bold: True
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: 0.07, 0.07, 0.07, 1
            canvas.before:
                Color:
                    rgba: app.accent_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(25)]
            on_press: animations.button_flash(self); root.save_selection()

        Button:
            text: "SAVE ROUTINE"
            bold: True
            font_size: '12sp'
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: 0.0, 0.8, 1.0, 1
            border: (0, 0, 0, 0)
            canvas.before:
                Color:
                    rgba: 0.0, 0.8, 1.0, 0.15
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(25)]
            on_press: animations.button_flash(self); root.save_as_template()
