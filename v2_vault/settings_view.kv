# settings_view.kv - All buttons with transparent bg + rounded canvas
#:import animations animations
<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: app.canvas_bg
            Rectangle:
                pos: self.pos
                size: self.size
            # Subtle texture overlay
            Color:
                rgba: 1, 1, 1, 0.15
            Rectangle:
                source: 'assets/app_bg.jpeg'
                pos: self.pos
                size: self.size

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Label:
                text: "PROFILE SETTINGS"
                font_size: '22sp'
                bold: True
                color: app.accent_color

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            size_hint_y: 1

            BoxLayout:
                orientation: 'vertical'
                spacing: dp(15)
                size_hint_y: None
                height: self.minimum_height

                # ───────── BACKGROUND CARD ─────────
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(15)
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(100)
                    canvas.before:
                        Color:
                            rgba: app.card_bg
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    Label:
                        text: "BACKGROUND"
                        font_size: '13sp'
                        bold: True
                        halign: 'left'
                        size_hint_y: None
                        height: dp(18)
                        text_size: self.size
                        color: 0.6, 0.6, 0.6, 1

                    BoxLayout:
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(42)

                        Button:
                            id: btn_bg_charcoal
                            text: "Deep Charcoal"
                            font_size: '12sp'
                            bold: True
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            border: (0, 0, 0, 0)
                            color: (0.07, 0.07, 0.07, 1) if self.state == 'down' else (0.8, 0.8, 0.8, 1)
                            canvas.before:
                                Color:
                                    rgba: app.accent_color if self.state == 'down' else (0.18, 0.18, 0.18, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(14)]
                            on_press: animations.button_flash(self); root.set_background_theme("charcoal")

                        Button:
                            id: btn_bg_navy
                            text: "Deep Navy"
                            font_size: '12sp'
                            bold: True
                            background_normal: ''
                            background_down: ''
                            background_color: 0, 0, 0, 0
                            border: (0, 0, 0, 0)
                            color: (0.07, 0.07, 0.07, 1) if self.state == 'down' else (0.8, 0.8, 0.8, 1)
                            canvas.before:
                                Color:
                                    rgba: app.accent_color if self.state == 'down' else (0.18, 0.18, 0.18, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(14)]
                            on_press: animations.button_flash(self); root.set_background_theme("navy")

                # ───────── TRAINING ENVIRONMENT ─────────
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(15)
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(200)
                    canvas.before:
                        Color:
                            rgba: app.card_bg
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    Label:
                        text: "TRAINING ENVIRONMENT"
                        font_size: '13sp'
                        bold: True
                        halign: 'left'
                        size_hint_y: None
                        height: dp(18)
                        text_size: self.size
                        color: 0.6, 0.6, 0.6, 1

                    Button:
                        id: btn_commercial
                        text: "COMMERCIAL GYM"
                        background_normal: ''
                        background_down: ''
                        background_color: 0, 0, 0, 0
                        border: (0, 0, 0, 0)
                        color: (0.07, 0.07, 0.07, 1) if self.state == 'down' else (1, 1, 1, 1)
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.accent_color if self.state == 'down' else (0.15, 0.15, 0.15, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        on_press: animations.button_flash(self); root.update_profile_environment("commercial")

                    Button:
                        id: btn_home
                        text: "HOME GYM"
                        background_normal: ''
                        background_down: ''
                        background_color: 0, 0, 0, 0
                        border: (0, 0, 0, 0)
                        color: (0.07, 0.07, 0.07, 1) if self.state == 'down' else (1, 1, 1, 1)
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.accent_color if self.state == 'down' else (0.15, 0.15, 0.15, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        on_press: animations.button_flash(self); root.update_profile_environment("home_gym")

                    Button:
                        id: btn_cardio
                        text: "OUTDOOR ATHLETE"
                        background_normal: ''
                        background_down: ''
                        background_color: 0, 0, 0, 0
                        border: (0, 0, 0, 0)
                        color: (0.07, 0.07, 0.07, 1) if self.state == 'down' else (1, 1, 1, 1)
                        bold: True
                        canvas.before:
                            Color:
                                rgba: app.accent_color if self.state == 'down' else (0.15, 0.15, 0.15, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        on_press: animations.button_flash(self); root.update_profile_environment("cardio_only")

                # ───────── BIOMETRICS ─────────
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(15)
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(100)
                    canvas.before:
                        Color:
                            rgba: app.card_bg
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    Label:
                        text: f"CURRENT WEIGHT: {int(slider_weight.value)} kg"
                        bold: True
                        color: 0.9, 0.9, 0.9, 1
                        size_hint_y: None
                        height: dp(20)

                    Slider:
                        id: slider_weight
                        min: 40
                        max: 150
                        value: 75
                        step: 1
                        value_track: True
                        value_track_color: app.accent_color
                        on_value: root.on_weight_slider_change(self.value)

                # ───────── METRICS ─────────
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(50)
                    spacing: dp(10)

                    BoxLayout:
                        canvas.before:
                            Color:
                                rgba: app.card_bg
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                        Label:
                            id: lbl_bmi
                            text: "BMI: --"
                            bold: True
                            color: app.accent_color

                    BoxLayout:
                        canvas.before:
                            Color:
                                rgba: app.card_bg
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(12)]
                        Label:
                            id: lbl_tdee
                            text: "TDEE: -- kcal"
                            bold: True
                            color: app.accent_color

                # ───────── STATUS ─────────
                Label:
                    id: lbl_sync_status
                    text: "All changes saved locally."
                    font_size: '12sp'
                    color: 0.4, 0.4, 0.4, 1
                    size_hint_y: None
                    height: dp(20)

                Widget:
                    size_hint_y: None
                    height: dp(20)
