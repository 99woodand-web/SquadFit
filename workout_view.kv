# workout_view.kv - Single-page scrollable Active Workout Sheet
#:import animations animations
<WorkoutConsoleScreen>:
    orientation: 'vertical'
    padding: 0
    spacing: 0
    canvas.before:
        Color:
            rgba: app.canvas_bg
        Rectangle:
            pos: self.pos
            size: self.size
        # Subtle texture overlay
        Color:
            rgba: 1, 1, 1, 0.15
        Rectangle:
            source: 'assets/app_bg.jpeg'
            pos: self.pos
            size: self.size

    # ═══════════════════════════════════════════════════════════
    #  TOP BAR - Timer + Back + Finish/Edit
    # ═══════════════════════════════════════════════════════════
    BoxLayout:
        size_hint_y: None
        height: dp(56)
        padding: [dp(16), dp(8), dp(16), dp(8)]
        spacing: dp(10)

        # Back button
        MDIconButton:
            icon: "chevron-left"
            icon_size: '24sp'
            theme_text_color: "Custom"
            text_color: app.accent_color
            size_hint_x: None
            width: dp(48)
            on_release: animations.button_flash(self); root.go_back_to_calendar()

        # Workout title + timer
        BoxLayout:
            orientation: 'vertical'
            Label:
                id: lbl_workout_title
                text: "WORKOUT"
                font_size: '11sp'
                bold: True
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: None
                height: dp(18)
                shorten: True
                shorten_from: 'right'
                max_lines: 1
                text_size: self.width, None
            Label:
                id: lbl_timer_clock
                text: "00:00"
                font_size: '20sp'
                bold: True
                color: app.accent_color
                size_hint_y: None
                height: dp(24)

        # Finish button (active mode only) — right-aligned
        Widget:
            size_hint_x: None
            width: dp(8)
        Button:
            id: btn_finish
            text: "FINISH"
            size_hint_x: None
            width: dp(80)
            font_size: '12sp'
            bold: True
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: 1, 0.4, 0.4, 1
            opacity: 1 if root.screen_mode == 'active' else 0
            disabled: root.screen_mode != 'active'
            canvas.before:
                Color:
                    rgba: 1, 0.4, 0.4, 1
                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1.5
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(18)]
            on_press: animations.button_flash(self); root.finish_workout()

        # Edit Log button (history mode only)
        Button:
            id: btn_edit_log
            text: "EDIT LOG"
            size_hint_x: None
            width: dp(85)
            font_size: '11sp'
            bold: True
            background_normal: ''
            background_down: ''
            background_color: 0, 0, 0, 0
            color: app.accent_color
            opacity: 1 if root.screen_mode == 'history' else 0
            disabled: root.screen_mode != 'history'
            canvas.before:
                Color:
                    rgba: app.accent_color
                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1.5
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(18)]
            on_press: animations.button_flash(self); root.toggle_edit_mode()

    # ═══════════════════════════════════════════════════════════
    #  SCROLLABLE EXERCISE AREA
    # ═══════════════════════════════════════════════════════════
    ScrollView:
        id: exercise_scroll
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(3)
        bar_color: app.accent_color
        bar_color_normal: 0.2, 0.2, 0.2, 0.5

    # ═══════════════════════════════════════════════════════════
    #  FLOATING REST TIMER BANNER
    # ═══════════════════════════════════════════════════════════
    BoxLayout:
        id: rest_banner
        size_hint_y: None
        height: 0
        opacity: 0
        disabled: True
        padding: [dp(16), dp(6)]
        canvas.before:
            Color:
                rgba: app.accent_color[0], app.accent_color[1], app.accent_color[2], 0.9
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(0)]

        Label:
            id: lbl_rest_timer
            text: "REST 01:30"
            font_size: '18sp'
            bold: True
            color: 0.07, 0.07, 0.07, 1

    # ═══════════════════════════════════════════════════════════
    #  BOTTOM STATUS BAR
    # ═══════════════════════════════════════════════════════════
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        canvas.before:
            Color:
                rgba: app.card_bg
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            padding: [dp(16), dp(4)]
            Label:
                id: lbl_sync_status
                text: "Tap START then tap + on each set" if root.screen_mode == 'active' else "Viewing completed workout"
                font_size: '11sp'
                color: 0.5, 0.5, 0.5, 1

            Label:
                id: lbl_sets_completed
                text: "Sets: 0/0"
                font_size: '11sp'
                bold: True
                color: app.accent_color

        # Progress bar
        Widget:
            id: progress_bar_bg
            size_hint_y: None
            height: dp(4)
            canvas.before:
                Color:
                    rgba: 0.15, 0.15, 0.15, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(2)]

        Widget:
            id: progress_bar_fill
            size_hint_y: None
            height: dp(4)
            canvas.before:
                Color:
                    rgba: app.accent_color
                RoundedRectangle:
                    pos: self.pos
                    size: [self.width * 0, self.height]
                    radius: [dp(2)]

    # ═══════════════════════════════════════════════════════════
    #  START BUTTON (shown before workout begins, hidden in history)
    # ═══════════════════════════════════════════════════════════
    Button:
        id: btn_start
        text: "START WORKOUT"
        font_size: '18sp'
        bold: True
        size_hint_y: None
        height: dp(56) if root.screen_mode == 'active' else 0
        opacity: 1 if root.screen_mode == 'active' else 0
        disabled: root.screen_mode != 'active'
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        color: 0.07, 0.07, 0.07, 1
        canvas.before:
            Color:
                rgba: app.accent_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(0)]
        on_press: animations.button_flash(self); root.start_workout_timer()
