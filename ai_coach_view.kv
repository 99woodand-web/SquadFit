# ai_coach_view.kv
#:import animations animations
<AICoachScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(12)

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)
            MDIconButton:
                icon: "chevron-left"
                icon_size: '24sp'
                theme_text_color: "Custom"
                text_color: 0.8, 0.8, 0.8, 1
                size_hint_x: None
                width: dp(48)
                on_release: animations.button_flash(self); root.go_back()
            MDIconButton:
                icon: "brain"
                icon_size: '24sp'
                theme_text_color: "Custom"
                text_color: 0.2, 1.0, 0.6, 1
                size_hint_x: None
                width: dp(40)
            Label:
                text: "AI COACH"
                font_size: '20sp'
                bold: True
                color: 0.2, 1.0, 0.6, 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'

        # Scrollable content
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: 0
            BoxLayout:
                id: content_area
                orientation: 'vertical'
                spacing: dp(12)
                size_hint_y: None
                height: self.minimum_height
                padding: [0, 0, 0, dp(20)]
